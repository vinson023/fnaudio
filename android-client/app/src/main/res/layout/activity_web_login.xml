<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webLoginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101418"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FF171C22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/webLoginTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="飞牛登录"
            android:textColor="#FFF2F5F8"
            android:textSize="16sp" />

        <Button
            android:id="@+id/webLoginCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="取消"
            android:textAllCaps="false"
            android:textColor="#FF9FB4C8"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/webLoginProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="#FF176BEF" />

    <TextView
        android:id="@+id/webLoginHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF171C22"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:text="在下面的飞牛官方页面里登录，成功后会自动返回 fnAudio"
        android:textColor="#FF9FB4C8"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/webLoginWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
