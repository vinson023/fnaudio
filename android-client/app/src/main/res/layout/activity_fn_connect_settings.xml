<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fnConnectSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="12dp"
        android:paddingRight="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/fnConnectSettingsBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="返回"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="8dp"
                android:text="FN Connect"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="连接方式"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/fnConnectRouteMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/login_input"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/fnConnectSpeedMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="速度优先"
                android:textColor="#FF172033"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/fnConnectPublicMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="公网连接"
                android:textColor="#FF172033"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/fnConnectRelayMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="中继连接"
                android:textColor="#FF172033"
                android:textSize="15sp" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/login_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P2P 连接" android:textColor="#FF172033" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="允许 FN Connect 使用点对点中继" android:textColor="#FF738198" android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/fnConnectP2pEnabled"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="启用 P2P 连接" />
        </LinearLayout>

        <TextView
            android:id="@+id/fnConnectSettingsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFBFD7F5"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
