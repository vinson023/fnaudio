<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/loginRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/login_background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="600dp" android:orientation="vertical" android:paddingLeft="42dp" android:paddingTop="16dp" android:paddingRight="42dp" android:paddingBottom="24dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="44dp">
      <ImageButton android:id="@+id/fnConnectSettingsButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="end|center_vertical" android:background="@android:color/transparent" android:contentDescription="FN Connect 设置" android:padding="10dp" android:src="@drawable/ic_fn_connect_settings" />
    </FrameLayout>
    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:contentDescription="fnAudio" android:src="@drawable/ic_launcher" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="6dp" android:text="fnAudio" android:textColor="#FFFFFFFF" android:textSize="21sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="32dp"><EditText android:id="@+id/fnId" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/login_input" android:hint="设备地址或 FN ID" android:inputType="textUri" android:maxLines="1" android:paddingLeft="14dp" android:paddingRight="46dp" android:textColor="#FF171717" android:textColorHint="#FF8D8D8D" android:textSize="15sp" /><ImageButton android:id="@+id/historyButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="end|center_vertical" android:background="#00000000" android:contentDescription="历史连接" android:padding="11dp" android:src="@drawable/ic_history" /></FrameLayout>
    <ImageButton android:id="@+id/fnConnectButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:autofillHints="username" android:background="@drawable/login_input" android:hint="用户名" android:inputType="text" android:maxLines="1" android:paddingLeft="14dp" android:paddingRight="14dp" android:textColor="#FF171717" android:textColorHint="#FF8D8D8D" android:textSize="15sp" />
    <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:autofillHints="password" android:background="@drawable/login_input" android:hint="密码" android:inputType="textPassword" android:maxLines="1" android:paddingLeft="14dp" android:paddingRight="14dp" android:textColor="#FF171717" android:textColorHint="#FF8D8D8D" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal"><CheckBox android:id="@+id/savePassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="记住密码" android:textColor="#FFDCEBFC" android:textSize="13sp" /></LinearLayout>
    <CheckBox android:id="@+id/useHttps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="HTTPS 安全访问" android:textColor="#FFFFFFFF" android:textSize="13sp" />
    <CheckBox android:id="@+id/trustSelfSigned" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="允许自签名证书" android:textColor="#FFDCEBFC" android:textSize="12sp" />
    <Button android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:backgroundTint="#FFFFFFFF" android:text="登录" android:textAllCaps="false" android:textColor="#FF176BEF" android:textSize="17sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/loginProgressRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal" android:visibility="gone"><ProgressBar android:layout_width="18dp" android:layout_height="18dp"/><TextView android:id="@+id/loginStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#FFFFFFFF" android:textSize="12sp" /></LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/fnConnectSettingsSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFBFD7F5" android:textSize="12sp" />
    <EditText android:id="@+id/profileName" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><EditText android:id="@+id/host" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><EditText android:id="@+id/port" android:layout_width="1dp" android:layout_height="1dp" android:text="5666" android:visibility="gone" />
  </LinearLayout>
</ScrollView>
