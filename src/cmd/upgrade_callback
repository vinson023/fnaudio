#!/bin/bash
PYTHON_BIN="/var/apps/python312/target/bin/python3"
chmod +x "${TRIM_APPDEST}/target/ui/index.cgi" "${TRIM_APPDEST}/target/ui/cgi_proxy.py" 2>/dev/null || true
if [ -f "${TRIM_PKGETC}/config.json" ]; then
  configured_port="$(sed -n 's/.*"server_port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "${TRIM_PKGETC}/config.json" | head -n 1)"
  case "${configured_port}" in
    ''|*[!0-9]*) configured_port="18080" ;;
  esac
  for manifest in /var/apps/fnaudio/manifest "${TRIM_APPDEST}/manifest"; do
    if [ -f "${manifest}" ]; then
      "${PYTHON_BIN}" - "${manifest}" "${configured_port}" <<'PY'
import sys
from pathlib import Path
path = Path(sys.argv[1])
port = int(sys.argv[2])
try:
    lines = path.read_text(encoding="utf-8").splitlines(True)
except OSError:
    raise SystemExit(0)
updated = False
out = []
for line in lines:
    if line.lstrip().startswith("service_port"):
        newline = "\r\n" if line.endswith("\r\n") else "\n"
        out.append(f"service_port          = {port}{newline}")
        updated = True
    else:
        out.append(line)
if not updated:
    newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
    out.append(f"service_port          = {port}{newline}")
path.write_text("".join(out), encoding="utf-8")
PY
    fi
  done
  printf '{"server_port":%s}\n' "${configured_port}" > "${TRIM_APPDEST}/target/ui/service_port.json" 2>/dev/null || true
  old_path="${TRIM_APPDEST}/../share/music"
  new_path="${TRIM_APPDEST}/share/music"
  if grep -q "\"library_path\":\"${old_path}\"" "${TRIM_PKGETC}/config.json" 2>/dev/null; then
    mkdir -p "${new_path}" 2>/dev/null || true
    sed -i "s#\"library_path\":\"${old_path}\"#\"library_path\":\"${new_path}\"#" "${TRIM_PKGETC}/config.json"
  fi
fi
exit 0
