#!/bin/bash

umask 077

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
install -d -m 700 "${TRIM_PKGETC}" "${TRIM_PKGVAR}"
touch "${LOG_FILE}"
chmod 600 "${LOG_FILE}" "${TRIM_PKGETC}/config.json" 2>/dev/null || true
PYTHON_BIN="/var/apps/python312/target/bin/python3"
if [ -f "${TRIM_APPDEST}/target/server/server.py" ]; then
  APP_ROOT="${TRIM_APPDEST}/target/server"
elif [ -f "${TRIM_APPDEST}/server/server.py" ]; then
  APP_ROOT="${TRIM_APPDEST}/server"
else
  APP_ROOT="${TRIM_APPDEST}/target/server"
fi
SERVER_PORT="53199"
if [ -f "${TRIM_PKGETC}/config.json" ]; then
  configured_port="$(sed -n 's/.*"server_port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "${TRIM_PKGETC}/config.json" | head -n 1)"
  case "${configured_port}" in
    ''|*[!0-9]*) ;;
    *) SERVER_PORT="${configured_port}" ;;
  esac
fi
UI_ROOT="${TRIM_APPDEST}/target/ui"
if [ ! -d "${UI_ROOT}" ] && [ -d "${TRIM_APPDEST}/ui" ]; then
  UI_ROOT="${TRIM_APPDEST}/ui"
fi
mkdir -p "${UI_ROOT}" 2>/dev/null || true
# fnAudio is exposed through the fnOS CGI entry. manifest.service_port is
# package metadata only; the configured backend port is validated below.

log_msg() {
  mkdir -p "${TRIM_PKGVAR}"
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
  kill -0 "$1" 2>/dev/null
}

stop_pid() {
  candidate="$1"
  wait_seconds="${2:-10}"
  case "${candidate}" in
    ''|*[!0-9]*|"$$") return 0 ;;
  esac
  if check_process "${candidate}"; then
    kill -TERM "${candidate}" 2>/dev/null || true
    for i in $(seq 1 "${wait_seconds}"); do
      check_process "${candidate}" || break
      sleep 1
    done
    check_process "${candidate}" && kill -KILL "${candidate}" 2>/dev/null || true
  fi
}

cleanup_stale_servers() {
  keep_pid="${1:-}"
  for proc in /proc/[0-9]*; do
    [ -r "${proc}/cmdline" ] || continue
    candidate="${proc##*/}"
    [ "${candidate}" = "${keep_pid}" ] && continue
    cmdline="$(tr '\000' ' ' < "${proc}/cmdline" 2>/dev/null)"
    case "${cmdline}" in
      *"@appcenter/fnaudio/"*"server.py"*)
        log_msg "Stopping stale fnAudio server PID ${candidate}"
        stop_pid "${candidate}" 10
        ;;
    esac
  done
}

configured_port_available() {
  "${PYTHON_BIN}" - "${SERVER_PORT}" <<'PY'
import socket
import sys

port = max(1024, min(65535, int(sys.argv[1])))
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(("0.0.0.0", port))
PY
}

persist_backend_port() {
  export FNAUDIO_SERVER_PORT="${SERVER_PORT}"
  "${PYTHON_BIN}" - "${TRIM_PKGETC}/config.json" <<'PY'
import json, os, sys
path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as fh: payload = json.load(fh)
except Exception: payload = {}
payload["server_port"] = int(os.environ["FNAUDIO_SERVER_PORT"])
with open(path, "w", encoding="utf-8") as fh: json.dump(payload, fh, ensure_ascii=False)
PY
  chmod 600 "${TRIM_PKGETC}/config.json" 2>/dev/null || true
  printf '{"server_port":%s}\n' "${SERVER_PORT}" > "${UI_ROOT}/service_port.json" 2>/dev/null || true
  chmod 644 "${UI_ROOT}/service_port.json" 2>/dev/null || true
}

port_ready() {
  "${PYTHON_BIN}" - "$1" <<'PY' >/dev/null 2>&1
import socket, sys
port = int(sys.argv[1])
with socket.create_connection(("127.0.0.1", port), timeout=1):
    pass
PY
}

status() {
  if [ -f "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    if check_process "${pid}"; then return 0; fi
    rm -f "${PID_FILE}"
  fi
  return 1
}

start_process() {
  mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}"
  active_pid=""
  if [ -f "${PID_FILE}" ]; then
    active_pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    check_process "${active_pid}" || active_pid=""
  fi
  # Older packages stored their PID and config under the application tree.
  # Upgrading could therefore leave the old server listening on its previous
  # port. Keep the currently supervised process, but remove every other
  # fnAudio server before deciding whether a new one is needed.
  cleanup_stale_servers "${active_pid}"
  if status; then return 0; fi
  if [ ! -x "${PYTHON_BIN}" ]; then
    log_msg "Python runtime not found: ${PYTHON_BIN}"
    return 1
  fi
  if [ ! -f "${APP_ROOT}/server.py" ]; then
    log_msg "Application server not found: ${APP_ROOT}/server.py"
    return 1
  fi
  configured_port_available || {
    log_msg "Configured TCP port ${SERVER_PORT} is already in use; change it in App Center settings"
    return 1
  }
  persist_backend_port
  CMD="TRIM_API_TOKEN=\"\${TRIM_API_TOKEN:-}\" ${PYTHON_BIN} ${APP_ROOT}/server.py --host 0.0.0.0 --port ${SERVER_PORT} --config ${TRIM_PKGETC}/config.json"
  if [ -n "${TRIM_API_TOKEN:-}" ]; then
    log_msg "Starting fnAudio with fnOS API token available"
  else
    log_msg "Starting fnAudio without fnOS API token"
  fi
  nohup bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
  printf "%s" "$!" > "${PID_FILE}"
  chmod 600 "${PID_FILE}" 2>/dev/null || true
  for i in $(seq 1 12); do
    port_ready "${SERVER_PORT}" && return 0
    if ! check_process "$!"; then
      log_msg "fnAudio server exited during startup; see log above"
      rm -f "${PID_FILE}"
      return 1
    fi
    sleep 0.5
  done
  log_msg "fnAudio server process started but TCP port ${SERVER_PORT} is not ready yet"
}

stop_process() {
  # Stop the supervisor first. Otherwise it can immediately restart MPD while
  # this script is trying to terminate the existing child process.
  if [ -f "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    stop_pid "${pid}" 10
    rm -f "${PID_FILE}"
  fi

  # PID files moved from the legacy application directory to @appdata. Sweep
  # matching server command lines as a migration-safe fallback so an upgrade
  # cannot leave two playback supervisors running at once.
  cleanup_stale_servers ""

  mpd_pid_file="${TRIM_APPDEST}/share/mpd/mpd.pid"
  if [ -f "${mpd_pid_file}" ]; then
    mpd_pid="$(head -n 1 "${mpd_pid_file}" | tr -d '[:space:]')"
    stop_pid "${mpd_pid}" 5
  fi

  # A stale PID file must not leave a private MPD process playing after the
  # application is stopped. The pattern is specific to fnAudio's MPD config,
  # so system MPD instances are never touched.
  for proc in /proc/[0-9]*; do
    [ -r "${proc}/cmdline" ] || continue
    cmdline="$(tr '\000' ' ' < "${proc}/cmdline" 2>/dev/null)"
    case "${cmdline}" in
      *"mpd"*"fnaudio"*"mpd.conf"*) stop_pid "${proc##*/}" 5 ;;
    esac
  done
  rm -f "${mpd_pid_file}" 2>/dev/null || true
}

case "$1" in
  start) start_process ;;
  stop) stop_process ;;
  status) status && exit 0 || exit 3 ;;
  *) exit 1 ;;
esac
