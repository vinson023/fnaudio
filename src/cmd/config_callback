#!/bin/bash
mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}"
PYTHON_BIN="/var/apps/python312/target/bin/python3"

server_port="${wizard_server_port:-}"
current_server_port=""

if [ -f "${TRIM_PKGETC}/config.json" ]; then
  current_server_port="$("${PYTHON_BIN}" - "${TRIM_PKGETC}/config.json" <<'PY'
import json, sys
try:
    print(int(json.load(open(sys.argv[1], encoding="utf-8")).get("server_port") or 18080))
except Exception:
    print("")
PY
)"
  if [ -z "${server_port}" ]; then
    server_port="${current_server_port:-18080}"
  fi
fi

server_port="${server_port:-18080}"
case "${server_port}" in
  ''|*[!0-9]*) server_port="18080" ;;
esac
if [ "${server_port}" -lt 1024 ] || [ "${server_port}" -gt 65535 ]; then
  server_port="18080"
fi

if [ "${server_port}" != "${current_server_port:-}" ]; then
  "${PYTHON_BIN}" - "${server_port}" <<'PY'
import socket
import sys

port = int(sys.argv[1])
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind(("0.0.0.0", port))
    except OSError:
        print("TCP 端口 %s 已被占用，请换一个未占用端口。" % port)
        raise SystemExit(1)
PY
  if [ "$?" -ne 0 ]; then
    exit 1
  fi
fi

export FNAUDIO_SERVER_PORT="${server_port}"
"${PYTHON_BIN}" - "${TRIM_PKGETC}/config.json" <<'PY'
import json, os
import sys
config_path = sys.argv[1]
try:
    with open(config_path, encoding="utf-8") as fh:
        payload = json.load(fh)
except Exception:
    payload = {"library_path": "", "library_paths": [], "server_name": "fnAudio"}
payload["server_name"] = "fnAudio"
payload["server_port"] = int(os.environ.get("FNAUDIO_SERVER_PORT") or 18080)
with open(config_path, "w", encoding="utf-8") as fh:
    json.dump(payload, fh, ensure_ascii=False)
PY
for manifest in /var/apps/fnaudio/manifest "${TRIM_APPDEST}/manifest"; do
  if [ -f "${manifest}" ]; then
    "${PYTHON_BIN}" - "${manifest}" "${server_port}" <<'PY'
import sys
from pathlib import Path
path = Path(sys.argv[1])
port = int(sys.argv[2])
try:
    lines = path.read_text(encoding="utf-8").splitlines(True)
except OSError:
    raise SystemExit(0)
updated = False
out = []
for line in lines:
    if line.lstrip().startswith("service_port"):
        newline = "\r\n" if line.endswith("\r\n") else "\n"
        out.append(f"service_port          = {port}{newline}")
        updated = True
    else:
        out.append(line)
if not updated:
    newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
    out.append(f"service_port          = {port}{newline}")
path.write_text("".join(out), encoding="utf-8")
PY
  fi
done
printf '{"server_port":%s}\n' "${server_port}" > "${TRIM_APPDEST}/target/ui/service_port.json" 2>/dev/null || true
exit 0
