#!/bin/bash
umask 077
install -d -m 700 "${TRIM_PKGETC}" "${TRIM_PKGVAR}"
PYTHON_BIN="/var/apps/python312/target/bin/python3"

requested_server_port="${wizard_server_port:-}"
current_server_port=""

if [ -f "${TRIM_PKGETC}/config.json" ]; then
  current_server_port="$("${PYTHON_BIN}" - "${TRIM_PKGETC}/config.json" <<'PY'
import json, sys
try:
    candidate = json.load(open(sys.argv[1], encoding="utf-8")).get("server_port")
    if isinstance(candidate, int) and not isinstance(candidate, bool) and 1024 <= candidate <= 65535:
        print(candidate)
    else:
        print(53199)
except Exception:
    print(53199)
PY
)"
fi

server_port="${requested_server_port:-${current_server_port:-53199}}"
case "${server_port}" in
  ''|*[!0-9]*)
    echo "服务端口必须是数字。"
    exit 1
    ;;
esac
if [ "${server_port}" -lt 1024 ] || [ "${server_port}" -gt 65535 ]; then
  echo "服务端口必须在 1024 到 65535 之间。"
  exit 1
fi

if [ "${server_port}" != "${current_server_port:-}" ]; then
  "${PYTHON_BIN}" - "${server_port}" <<'PY'
import socket
import sys

port = int(sys.argv[1])
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind(("0.0.0.0", port))
    except OSError:
        print("服务端口 %s 已被占用，请选择其他未占用端口。" % port)
        raise SystemExit(1)
PY
  [ "$?" -eq 0 ] || exit 1
fi

export FNAUDIO_SERVER_PORT="${server_port}"
if ! "${PYTHON_BIN}" - "${TRIM_PKGETC}/config.json" <<'PY'
import json, os, tempfile
import sys
config_path = sys.argv[1]
try:
    with open(config_path, encoding="utf-8") as fh:
        payload = json.load(fh)
except Exception:
    payload = {"library_path": "", "library_paths": [], "server_name": "fnAudio"}
if not isinstance(payload, dict):
    payload = {"library_path": "", "library_paths": [], "server_name": "fnAudio"}
payload["server_name"] = "fnAudio"
payload["server_port"] = int(os.environ.get("FNAUDIO_SERVER_PORT") or 53199)
fd, temporary = tempfile.mkstemp(prefix=".config.json.", dir=os.path.dirname(config_path) or ".")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, ensure_ascii=False)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(temporary, config_path)
except Exception:
    try: os.unlink(temporary)
    except OSError: pass
    raise
PY
then
  echo "无法更新配置文件。" >&2
  exit 1
fi
if ! chmod 600 "${TRIM_PKGETC}/config.json"; then
  echo "无法设置配置文件权限。" >&2
  exit 1
fi
# Do not rewrite manifest.service_port. The CGI proxy consumes the private
# backend port written above through service_port.json.
UI_ROOT="${TRIM_APPDEST}/target/ui"
if [ ! -d "${UI_ROOT}" ] && [ -d "${TRIM_APPDEST}/ui" ]; then
  UI_ROOT="${TRIM_APPDEST}/ui"
fi
if ! mkdir -p "${UI_ROOT}"; then
  echo "无法创建 UI 运行目录。" >&2
  exit 1
fi
service_port_tmp="${UI_ROOT}/service_port.json.tmp.$$"
if ! printf '{"server_port":%s}\n' "${server_port}" > "${service_port_tmp}" || ! mv -f -- "${service_port_tmp}" "${UI_ROOT}/service_port.json"; then
  rm -f -- "${service_port_tmp}"
  echo "无法写入 service_port.json。" >&2
  exit 1
fi
if ! chmod 644 "${UI_ROOT}/service_port.json"; then
  echo "无法设置 service_port.json 权限。" >&2
  exit 1
fi
exit 0
