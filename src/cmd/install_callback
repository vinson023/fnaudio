#!/bin/bash
mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}"
chmod +x "${TRIM_APPDEST}/target/ui/index.cgi" "${TRIM_APPDEST}/target/ui/cgi_proxy.py" 2>/dev/null || true

PYTHON_BIN="/var/apps/python312/target/bin/python3"
config_path="${TRIM_PKGETC}/config.json"
existing_library_path=""
existing_server_port=""
if [ -f "${config_path}" ]; then
  existing_library_path="$("${PYTHON_BIN}" - "${config_path}" <<'PY'
import json, sys
try:
    payload = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    payload = {}
paths = payload.get("library_paths") or []
if isinstance(paths, list) and paths:
    print("\n".join(str(path).strip() for path in paths if str(path).strip()))
else:
    print(str(payload.get("library_path") or "").strip())
PY
)"
  existing_server_port="$("${PYTHON_BIN}" - "${config_path}" <<'PY'
import json, sys
try:
    print(int(json.load(open(sys.argv[1], encoding="utf-8")).get("server_port") or 18080))
except Exception:
    print(18080)
PY
)"
fi
library_path="${wizard_library_paths:-${wizard_library_path:-}}"
for index in $(seq 1 20); do
  name="wizard_library_path_${index}"
  value="${!name:-}"
  if [ -n "${value}" ]; then
    library_path="$(printf '%s\n%s\n' "${library_path}" "${value}")"
  fi
done
library_path="${library_path:-${TRIM_APPDEST}/share/music}"
server_port="${wizard_server_port:-18080}"
case "${server_port}" in
  ''|*[!0-9]*) server_port="18080" ;;
esac
if [ "${server_port}" -lt 1024 ] || [ "${server_port}" -gt 65535 ]; then
  server_port="18080"
fi

server_port="$("${PYTHON_BIN}" - "${server_port}" <<'PY'
import socket
import sys

requested = int(sys.argv[1])

def available(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("0.0.0.0", int(port)))
            return True
        except OSError:
            return False

if available(requested):
    print(requested)
    raise SystemExit(0)

for port in range(max(1024, requested + 1), 65536):
    if available(port):
        print(port)
        raise SystemExit(0)
print(requested)
PY
)"

if [ -n "${existing_library_path}" ]; then
  default_install_path="${TRIM_APPDEST}/share/music"
  if [ -z "${library_path}" ] || [ "${library_path}" = "/vol1/1000/music" ] || [ "${library_path}" = "${default_install_path}" ]; then
    library_path="${existing_library_path}"
  fi
fi
if [ -n "${existing_server_port}" ] && [ "${server_port}" = "18080" ] && [ "${existing_server_port}" != "18080" ]; then
  server_port="${existing_server_port}"
fi

if [ "${library_path}" = "auto" ]; then
  library_path=""
  for candidate in /vol*/1000/music /volume*/1000/music; do
    if [ -d "${candidate}" ]; then library_path="${candidate}"; break; fi
  done
  library_path="${library_path:-${TRIM_APPDEST}/share/music}"
fi

printf '{"server_port":%s}\n' "${server_port}" > "${TRIM_APPDEST}/target/ui/service_port.json" 2>/dev/null || true

export FNAUDIO_LIBRARY_PATHS="${library_path}"
export FNAUDIO_SERVER_PORT="${server_port}"
"${PYTHON_BIN}" - <<'PY'
import json, os
config_path = os.path.join(os.environ["TRIM_PKGETC"], "config.json")
raw = os.environ.get("FNAUDIO_LIBRARY_PATHS") or ""
paths = [x.strip() for x in raw.replace(";", "\n").splitlines() if x.strip()]
for path in paths:
    try:
        os.makedirs(path, exist_ok=True)
    except OSError:
        pass
payload = {"library_path": "\n".join(paths), "library_paths": paths, "server_name": "fnAudio", "server_port": int(os.environ.get("FNAUDIO_SERVER_PORT") or 18080)}
with open(config_path, "w", encoding="utf-8") as fh:
    json.dump(payload, fh, ensure_ascii=False)
PY
for manifest in /var/apps/fnaudio/manifest "${TRIM_APPDEST}/manifest"; do
  if [ -f "${manifest}" ]; then
    "${PYTHON_BIN}" - "${manifest}" "${server_port}" <<'PY'
import sys
from pathlib import Path
path = Path(sys.argv[1])
port = int(sys.argv[2])
try:
    lines = path.read_text(encoding="utf-8").splitlines(True)
except OSError:
    raise SystemExit(0)
updated = False
out = []
for line in lines:
    if line.lstrip().startswith("service_port"):
        newline = "\r\n" if line.endswith("\r\n") else "\n"
        out.append(f"service_port          = {port}{newline}")
        updated = True
    else:
        out.append(line)
if not updated:
    newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
    out.append(f"service_port          = {port}{newline}")
path.write_text("".join(out), encoding="utf-8")
PY
  fi
done
exit 0
