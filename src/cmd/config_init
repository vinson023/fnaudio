#!/bin/bash
umask 077
PYTHON_BIN="/var/apps/python312/target/bin/python3"
"${PYTHON_BIN}" - <<'PY'
import json
import os
import tempfile

appdest = os.environ.get("TRIM_APPDEST", "")
pkgetc = os.environ.get("TRIM_PKGETC", "")
if not appdest or not pkgetc:
    raise RuntimeError("fnAudio runtime paths are unavailable")
config_path = os.path.join(pkgetc, "config.json")
port = 53199
try:
    with open(config_path, encoding="utf-8") as fh:
        candidate = json.load(fh).get("server_port")
        port = int(candidate) if isinstance(candidate, int) and not isinstance(candidate, bool) else 53199
        if port < 1024 or port > 65535:
            port = 53199
except Exception:
    port = 53199

payload = [{
    "stepTitle": "运行设置",
    "items": [{
        "type": "text",
        "field": "wizard_server_port",
        "label": "当前服务端口",
        "initValue": str(port),
        "helpText": "修改后重启 fnAudio 生效。端口被占用时，请选择其他端口。",
        "rules": [{"required": True, "message": "请输入服务端口"}],
    }],
}]
for rel in ("wizard/config", "target/wizard/config"):
    target = os.path.join(appdest, rel)
    directory = os.path.dirname(target)
    os.makedirs(directory, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".config.", dir=directory)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(payload, fh, ensure_ascii=False, indent=2)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(temporary, target)
    except Exception:
        try: os.unlink(temporary)
        except OSError: pass
        raise
PY
exit $?
