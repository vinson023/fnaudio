appname=fnaudio
version=0.2.35
display_name=fnAudio
desc=本地音乐播放器，支持高解析音乐库、歌词封面补全、USB DAC、DLNA 推送及 Android 锁屏控制。
platform=x86
source=thirdparty
developer=vinson023
publisher=vinson023
maintainer=vinson023
distributor=vinson023
# install_type=root asks fnOS for the system partition instead of a storage
# volume. The runtime layout is written against /var/apps/fnaudio (src/cmd and
# several src/app/server paths), so a volume install is what needs explaining.
# Leaving the key out makes fnOS ask for a storage location at install time.
install_type=root
install_dep_apps=python312
distributor_url=https://developer.fnnas.com/
maintainer_url=https://developer.fnnas.com/
desktop_uidir=ui
desktop_applaunchname=fnaudio.Application
service_port=53199
ctl_stop=true
# fnAudio is exposed through fnOS CGI. The private backend port is managed by
# the install/config wizard, so App Center must not reserve this metadata value.
checkport=false
# fnAudio uses the fnOS micro-app container so the CGI page is hosted in the
# App Center iframe. This preserves the previous WebView integration path.
micro_app=true
